
# ==========================================
# CONFIGURACIÓN DE MICROSOFT AZURE / ENTRA ID
# ==========================================

# Client ID de la Aplicación registrada en Azure
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant ID: 'common' para multi-tenant o el GUID específico de tu organización
AZURE_TENANT_ID=common

# ==========================================
# CONFIGURACIÓN DE SHAREPOINT (MICROSOFT GRAPH)
# ==========================================

# ID del Sitio de SharePoint (hostname,site_id,web_id)
# Se obtiene vía Graph Explorer: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-path}
SHAREPOINT_SITE_ID=your-sharepoint-site-id-placeholder

# IDs de las Listas de SharePoint donde se almacenan los datos
# Se obtienen vía Graph Explorer: GET https://graph.microsoft.com/v1.0/sites/{site-id}/lists
SHAREPOINT_LIST_ID_PROJECTS=your-projects-list-id-placeholder
SHAREPOINT_LIST_ID_TASKS=your-tasks-list-id-placeholder
SHAREPOINT_LIST_ID_ACTIVITIES=your-activities-list-id-placeholder
